diff --git a/kernel/audio/probe.h b/kernel/audio/probe.h
new file mode 100644
index 00000000..2cca5166
--- /dev/null
+++ b/kernel/audio/probe.h
@@ -0,0 +1,41 @@
+/* Temporary measurement counters on the unmerged cost probe only. */
+#ifndef AUDIO_COST_PROBE_H
+#define AUDIO_COST_PROBE_H
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdatomic.h>
+#include <arch/smp.h>
+struct probe_time { uint64_t calls, ticks; };
+struct audio_cost_probe {
+  atomic_bool enabled;
+  uint64_t target_sessions, begin_tsc, end_tsc;
+  struct probe_time mix, inner, output, queue_copy, position, hda_mmio, irq, request;
+  struct probe_time hpet[64], stage_copy[64], prepare_request[64];
+  uint64_t hpet_reads[64];
+  uint64_t hpet_first_ns[64], hpet_last_ns[64], hpet_first_tsc[64], hpet_last_tsc[64];
+  uint64_t loops, sleeps, notifications, requests, writes, accepted_bytes, mixed_frames;
+  uint64_t hpet_callers[64][3];
+  struct probe_time hpet_if0[64], timer_time[64], readiness_time[64], net_time[64];
+  struct probe_time hpet_caller_if0[64];
+  uint64_t readiness_wakes[64], net_wakes[64], audio_wakes;
+  uint64_t readiness[64], net_notify[64], schedules[64], timer_arm[64], poll_sleeps;
+};
+extern struct audio_cost_probe audio_cost;
+static inline uint64_t probe_tsc(void)
+{
+  uint32_t low, high, aux;
+  __asm__ volatile("lfence; rdtscp; lfence" : "=a"(low), "=d"(high), "=c"(aux) :: "memory");
+  return ((uint64_t)high << 32) | low;
+}
+static inline uint64_t probe_begin(void)
+{
+  return audio_cost.enabled ? probe_tsc() : 0;
+}
+static inline void probe_end(struct probe_time *time, uint64_t begin)
+{
+  if (begin && audio_cost.enabled) {
+    time->ticks += probe_tsc() - begin;
+    ++time->calls;
+  }
+}
+#endif
