diff --git a/arch/x86_64/clock.c b/arch/x86_64/clock.c
index ea86eec7..648c679e 100644
--- a/arch/x86_64/clock.c
+++ b/arch/x86_64/clock.c
@@ -1,0 +2 @@
+#include "../../kernel/audio/probe.h"
@@ -36,0 +38,3 @@ static uint32_t hpet_read(unsigned offset)
+  if (audio_cost.enabled && (offset == HPET_COUNTER || offset == HPET_COUNTER + 4)) {
+    ++audio_cost.hpet_reads[arch_cpu_index()];
+  }
@@ -153,0 +158,3 @@ uint64_t arch_monotonic_ns(void)
+  uint64_t probe_start = probe_begin();
+  uint64_t probe_flags = probe_start ? cpu_save_interrupts() : 0;
+  if (probe_start) { cpu_restore_interrupts(probe_flags); }
@@ -168 +175,36 @@ uint64_t arch_monotonic_ns(void)
-  return whole * period_fs + fraction;
+  uint64_t result = whole * period_fs + fraction;
+  if (probe_start && audio_cost.enabled) {
+    unsigned cpu = arch_cpu_index();
+    uint64_t end = probe_tsc();
+    uint64_t flags = cpu_save_interrupts();
+    if (!cpu) {
+      uint64_t caller = (uintptr_t)__builtin_return_address(0);
+      for (unsigned i = 0; i < 64; ++i) {
+        uint64_t *slot = audio_cost.hpet_callers[i];
+        if (!slot[0] || slot[0] == caller) {
+          slot[0] = caller;
+          ++slot[1];
+          slot[2] += end - probe_start;
+          if (!(probe_flags & RFLAGS_INTERRUPT_ENABLE)) {
+            ++audio_cost.hpet_caller_if0[i].calls;
+            audio_cost.hpet_caller_if0[i].ticks += end - probe_start;
+          }
+          break;
+        }
+      }
+    }
+    if (!audio_cost.hpet[cpu].calls) {
+      audio_cost.hpet_first_ns[cpu] = result;
+      audio_cost.hpet_first_tsc[cpu] = end;
+    }
+    audio_cost.hpet_last_ns[cpu] = result;
+    audio_cost.hpet_last_tsc[cpu] = end;
+    audio_cost.hpet[cpu].ticks += end - probe_start;
+    ++audio_cost.hpet[cpu].calls;
+    if (!(probe_flags & RFLAGS_INTERRUPT_ENABLE)) {
+      ++audio_cost.hpet_if0[cpu].calls;
+      audio_cost.hpet_if0[cpu].ticks += end - probe_start;
+    }
+    cpu_restore_interrupts(flags);
+  }
+  return result;
