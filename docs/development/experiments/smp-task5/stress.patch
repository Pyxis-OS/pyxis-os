diff --git a/kernel/task.c b/kernel/task.c
index c3b13e0..4934c93 100644
--- a/kernel/task.c
+++ b/kernel/task.c
@@ -21,6 +21,9 @@
 #include <kernel/wait.h>
 #include <stdatomic.h>
 #include <arch/cpu_local.h>
+#include <arch/paging.h>
+#include <kernel/mm/pmm.h>
+#include <kernel/mm/pressure.h>
 
 #define TASK_STACK_SIZE (16 * 1024)
 
@@ -910,6 +913,100 @@ void kernel_task_yield_if_runnable(void)
   cpu_restore_interrupts(flags);
 }
 
+/* SCRATCH STRESS ONLY. */
+bool pmm_debug_check(size_t *counted, struct pmm_stats *snapshot);
+bool arch_debug_frame_check(phys_addr_t physical, uint64_t pattern);
+static atomic_size_t stress_running;
+extern size_t pressure_debug_woken, pressure_debug_early;
+
+static void scratch_stress(size_t cpu_index)
+{
+  cpu_disable_interrupts();
+  atomic_fetch_add(&stress_running, 1);
+  uint64_t end = arch_monotonic_ns() + UINT64_C(6000000000);
+  size_t rounds = 0, frames = 0, failures = 0, mismatches = 0, spaces = 0, notices = 0;
+  size_t refused = 0, granted_large = 0;
+  while (arch_monotonic_ns() < end) {
+    size_t pages = 1 + rounds % 4;
+    phys_addr_t physical = pmm_alloc(pages);
+    if (!physical) {
+      ++failures;
+    } else {
+      for (size_t i = 0; i < pages; ++i) {
+        arch_frame_zero(physical + i * PAGE_SIZE);
+        if (!arch_debug_frame_check(physical + i * PAGE_SIZE,
+                                    (uint64_t)cpu_index << 56 | rounds << 8 | i)) {
+          ++mismatches;
+        }
+      }
+      frames += pages;
+      pmm_free(physical, pages);
+    }
+
+    /* Walks of an inactive private root use only this CPU's slots. */
+    if (rounds % 16 == 0) {
+      struct arch_address_space space = {0};
+      phys_addr_t data = pmm_alloc(1);
+      if (data && arch_space_create(&space) == MM_OK) {
+        uintptr_t address = UINT64_C(0x40000000) + (rounds % 512) * UINT64_C(0x200000);
+        if (arch_page_map(&space, address, data, PAGE_WRITE | PAGE_USER) != MM_OK) {
+          ++failures;
+        }
+        struct page_translation translation;
+        if (arch_page_query(&space, address, &translation) != MM_OK ||
+            (translation.physical & ~(PAGE_SIZE - 1)) != data) {
+          ++mismatches;
+        }
+        phys_addr_t unmapped = 0;
+        if (arch_page_unmap(&space, address, &unmapped) != MM_OK || unmapped != data) {
+          ++mismatches;
+        }
+        if (arch_space_destroy(&space) != MM_OK) {
+          ++failures;
+        }
+        ++spaces;
+      } else {
+        ++failures;
+      }
+      if (data) {
+        pmm_free(data, 1);
+      }
+    }
+    /* A request larger than every free run scans the whole bitmap and fails;
+     * one larger than the free count fails before scanning. */
+    if (rounds % 256 == 128) {
+      size_t want = pmm_get_stats().free_frames;
+      size_t pages_large = rounds % 512 == 128 ? want : want + 1;
+      phys_addr_t large = pmm_alloc(pages_large);
+      if (large) {
+        ++granted_large;
+        pmm_free(large, pages_large);
+      } else {
+        ++refused;
+      }
+    }
+    if (rounds % 1024 == 0) {
+      mm_pressure_notify();
+      ++notices;
+    }
+    ++rounds;
+  }
+
+  size_t counted;
+  struct pmm_stats stats;
+  bool consistent = pmm_debug_check(&counted, &stats);
+  klog("stress: CPU %zu rounds=%zu frames=%zu spaces=%zu notices=%zu failures=%zu "
+       "mismatches=%zu refused=%zu granted_large=%zu; PMM %s counted=%zu allocated=%zu "
+       "free=%zu total=%zu\n",
+       cpu_index, rounds, frames, spaces, notices, failures, mismatches, refused, granted_large,
+       consistent ? "consistent" : "INCONSISTENT", counted, stats.allocated_frames,
+       stats.free_frames, stats.total_frames);
+  if (atomic_fetch_sub(&stress_running, 1) == 1) {
+    klog("stress: pressure observer woken=%zu early=%zu\n", pressure_debug_woken,
+         pressure_debug_early);
+  }
+}
+
 [[noreturn]] void task_schedule(void)
 {
   size_t cpu_index = arch_cpu_index();
@@ -921,6 +1018,7 @@ void kernel_task_yield_if_runnable(void)
     while (!atomic_load_explicit(&started, memory_order_acquire)) {
       cpu_wait_interrupt();
     }
+    scratch_stress(cpu_index);
   }
 
   struct scheduler *scheduler = local_scheduler();
