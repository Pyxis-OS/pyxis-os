diff --git a/arch/x86_64/paging.c b/arch/x86_64/paging.c
index 27ed5e1..caf60fd 100644
--- a/arch/x86_64/paging.c
+++ b/arch/x86_64/paging.c
@@ -873,3 +873,22 @@ size_t arch_user_vm_size(void)
 {
   return LOWER_HALF_MAX + 1 - PAGE_SIZE;
 }
+
+/* SCRATCH STRESS ONLY: expect zero, write PATTERN through the data slot and
+ * read it back through the table slot mapped to the same frame. */
+bool arch_debug_frame_check(phys_addr_t physical, uint64_t pattern)
+{
+  volatile uint64_t *data = map_scratch(physical, SCRATCH_DATA);
+  bool ok = true;
+  for (size_t i = 0; i < PAGE_SIZE / sizeof(uint64_t); ++i) {
+    ok = ok && data[i] == 0;
+    data[i] = pattern ^ i;
+  }
+  volatile uint64_t *table = map_scratch(physical, SCRATCH_TABLE);
+  for (size_t i = 0; i < PAGE_SIZE / sizeof(uint64_t); ++i) {
+    ok = ok && table[i] == (pattern ^ i);
+  }
+  unmap_scratch(SCRATCH_TABLE);
+  unmap_scratch(SCRATCH_DATA);
+  return ok;
+}
diff --git a/kernel/mm/pmm.c b/kernel/mm/pmm.c
index ccf555f..642b53c 100644
--- a/kernel/mm/pmm.c
+++ b/kernel/mm/pmm.c
@@ -231,3 +231,20 @@ struct pmm_stats pmm_get_stats(void)
   spin_unlock(&pmm_lock);
   return snapshot;
 }
+
+/* SCRATCH STRESS ONLY: recount allocated frames against the statistics. */
+bool pmm_debug_check(size_t *counted, struct pmm_stats *snapshot)
+{
+  spin_lock(&pmm_lock);
+  size_t allocated = 0;
+  for (size_t frame = 0; frame < frame_count; ++frame) {
+    if (bit_get(allocatable_bitmap, frame) && bit_get(unavailable_bitmap, frame)) {
+      ++allocated;
+    }
+  }
+  *snapshot = stats;
+  spin_unlock(&pmm_lock);
+  *counted = allocated;
+  return allocated == snapshot->allocated_frames &&
+         snapshot->free_frames + snapshot->allocated_frames == snapshot->total_frames;
+}
