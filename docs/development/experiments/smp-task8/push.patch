diff --git a/kernel/task.c b/kernel/task.c
index 3fd15c9..deb7737 100644
--- a/kernel/task.c
+++ b/kernel/task.c
@@ -568,9 +568,14 @@ static struct task *dequeue(struct scheduler *scheduler, size_t cpu_index)
 /* A task preempted at a user-mode boundary moves when another CPU it may use
  * is at least two tasks lighter, so equal neighbours do not trade it each tick.
  * The destination's reschedule IPI is its only notification. */
+/* SCRATCH ONLY: count load-gap pushes and log the first few after unlocking. */
+static atomic_size_t push_debug_count;
+
 static void requeue_preempted(struct task *task, size_t cpu_index)
 {
   size_t destination = cpu_index;
+  bool pushed = false;
+  size_t source_load = 0, target_load = 0;
   lock_queues();
   if (task_movable(task)) {
     struct space *space = task->process->space;
@@ -578,11 +583,21 @@ static void requeue_preempted(struct task *task, size_t cpu_index)
     if (!space_allows_cpu(space, cpu_index) ||
         load_locked(target) + 2 <= load_locked(cpu_index)) {
       destination = target;
+      pushed = space_allows_cpu(space, cpu_index);
+      source_load = load_locked(cpu_index);
+      target_load = load_locked(target);
     }
   }
   task->cpu_index = destination;
   enqueue_locked(&schedulers[destination], task);
   unlock_queues();
+  if (pushed) {
+    size_t count = atomic_fetch_add(&push_debug_count, 1) + 1;
+    if (count <= 8 || count % 1000 == 0) {
+      klog("push %zu: task %p CPU %zu (load %zu) -> CPU %zu (load %zu)\n", count,
+           (void *)task, cpu_index, source_load, destination, target_load);
+    }
+  }
   notify_remote_cpu(destination);
 }
 
