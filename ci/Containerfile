# Build this image once; normal Pyxis jobs only download and use it.
FROM docker.io/library/node:24-trixie AS toolchain

ENV PATH=/opt/cross/bin:${PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential bison flex texinfo libgmp-dev libmpfr-dev libmpc-dev \
    libisl-dev zlib1g-dev ca-certificates curl xz-utils patch \
    && rm -rf /var/lib/apt/lists/*

COPY toolchain/ /tmp/pyxis-toolchain/
RUN /tmp/pyxis-toolchain/build.sh /opt/cross /tmp/cross-build

FROM docker.io/library/node:24-trixie

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git make gcc cpio xorriso lua5.4 \
    libgmp10 libmpfr6 libmpc3 libisl23 zlib1g \
    && rm -rf /var/lib/apt/lists/*

# Put any internal CA certificates in ci/*.crt before building this image.
COPY ci/ /tmp/pyxis-ci/
RUN for cert in /tmp/pyxis-ci/*.crt; do \
      [ -f "$cert" ] || continue; \
      install -m 0644 "$cert" /usr/local/share/ca-certificates/; \
    done \
    && update-ca-certificates \
    && rm -rf /tmp/pyxis-ci

COPY --from=toolchain /opt/cross /opt/cross
ENV PATH=/opt/cross/bin:${PATH}

RUN test "$(x86_64-unknown-pyxis-gcc -dumpfullversion)" = 16.2.0 \
    && x86_64-unknown-pyxis-ld --version | head -n 1 | grep -Fx 'GNU ld (GNU Binutils) 2.47.20260726' \
    && printf '' | cc -std=gnu23 -x c -fsyntax-only -

RUN rm -f /var/run && mkdir -p /var/run
