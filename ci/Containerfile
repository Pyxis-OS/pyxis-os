# Build this image once; normal Pyxis jobs only download and use it.
FROM docker.io/library/node:24-trixie AS toolchain

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build python3 git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# The toolchain build fetches the pinned fork commit from git.internal.
COPY ci/ /tmp/pyxis-ci/
RUN for cert in /tmp/pyxis-ci/*.crt; do \
      [ -f "$cert" ] || continue; \
      install -m 0644 "$cert" /usr/local/share/ca-certificates/; \
    done \
    && update-ca-certificates \
    && rm -rf /tmp/pyxis-ci

COPY toolchain/ /tmp/pyxis-toolchain/
RUN JOBS="$(nproc)" /tmp/pyxis-toolchain/build.sh /opt/cross /tmp/cross-build \
    && rm -rf /tmp/cross-build

FROM docker.io/library/node:24-trixie

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git make gcc cpio xorriso lua5.4 cmake curl bzip2 \
    pkg-config libfuse3-dev \
    && rm -rf /var/lib/apt/lists/*

# Put any internal CA certificates in ci/*.crt before building this image.
COPY ci/ /tmp/pyxis-ci/
RUN for cert in /tmp/pyxis-ci/*.crt; do \
      [ -f "$cert" ] || continue; \
      install -m 0644 "$cert" /usr/local/share/ca-certificates/; \
    done \
    && update-ca-certificates \
    && rm -rf /tmp/pyxis-ci

COPY --from=toolchain /opt/cross /opt/cross
ENV PATH=/opt/cross/bin:${PATH}

RUN test "$(x86_64-unknown-pyxis-clang -dumpversion)" = 23.1.3 \
    && grep -Fx 'commit=49e2c1a1518b3e4687b52ceb6001069c1b6d261e' \
      /opt/cross/share/pyxis-toolchain/llvm-revision \
    && printf '' | cc -std=gnu23 -x c -fsyntax-only -

RUN rm -f /var/run && mkdir -p /var/run
