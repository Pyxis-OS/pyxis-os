--- /dev/null
+++ b/gcc/config/pyxis.h
@@ -0,0 +1,38 @@
+/* Target definitions for Pyxis OS on x86-64.
+   This file is part of GCC and is distributed under GPL-3.0-or-later,
+   with the GCC Runtime Library Exception 3.1.  */
+
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS() \
+  do { builtin_define ("__pyxis__"); } while (0)
+
+/* Caelum does not yet save FP/SIMD state.  Use the integer subset of the
+   x86-64 System V calling convention, without a red zone.  */
+#undef SUBTARGET_DRIVER_SELF_SPECS
+#define SUBTARGET_DRIVER_SELF_SPECS \
+  "%{m32|mx32:%ePyxis supports only the x86-64 LP64 ABI}", \
+  "%{!mred-zone:%{!mno-red-zone:-mno-red-zone}}", \
+  "%{!mgeneral-regs-only:%{!mno-general-regs-only:-mgeneral-regs-only}}"
+
+/* Describe stack permissions in ELF objects, including ordinary C output. */
+#undef TARGET_ASM_FILE_END
+#define TARGET_ASM_FILE_END file_end_indicate_exec_stack
+
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC "%{!r:crt0.o%s}"
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC ""
+#undef LIB_SPEC
+#define LIB_SPEC "-lc -lpyxis"
+#undef LINK_GCC_C_SEQUENCE_SPEC
+#define LINK_GCC_C_SEQUENCE_SPEC "--start-group %G %{!nolibc:%L} --end-group"
+
+/* The SDK owns executable layout.  -nostdlib leaves the kernel's own script
+   alone; -T can replace the default for other explicit link layouts.  */
+#undef LINK_SPEC
+#define LINK_SPEC \
+  "-m elf_x86_64 -static " \
+  "%{shared:%ePyxis does not support shared libraries} " \
+  "%{pie:%ePyxis does not support PIE executables} " \
+  "%{!r:%{!nostdlib:%{!T*:-T pyxis.ld%s}}} " \
+  "--build-id=none -z max-page-size=0x1000"
--- /dev/null
+++ b/libgcc/config/t-pyxis
@@ -0,0 +1,8 @@
+# Caelum currently preserves only general registers.  Floating-point helpers
+# are intentionally absent; compiling them with a different ABI would make
+# libgcc appear usable for code the scheduler cannot safely run.
+LIBGCC2_CFLAGS += -mno-red-zone -mgeneral-regs-only
+LIB2FUNCS_EXCLUDE += _powisf2 _powidf2 _powixf2 _powitf2 \
+  _mulhc3 _mulsc3 _muldc3 _mulxc3 _multc3 \
+  _divhc3 _divsc3 _divdc3 _divxc3 _divtc3 \
+  $(subst XX,si,$(swfloatfuncs)) $(subst XX,di,$(dwfloatfuncs))
